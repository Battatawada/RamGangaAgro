NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

DATABASE_URL=
DATABASE_URL_MIGRATE=
DATABASE_URL_MESSAGES=
DATABASE_URL_PRIVACY=
# Canonical origin. Unset uses https://rgagro.me.
# Only https://rgagro.me or https://www.rgagro.me are accepted.
SITE_URL=
# The running host receives DATABASE_URL for rga_app only.
# Migration, inbox, and erasure URLs stay in .env.operator (development)
# or .env.production.operator (production). Neither file is committed.
# .env.production.local is the local production app check, not the host.
# postgres uses DATABASE_URL, the app login. upstash uses the Redis URL and token.
# Development may use RATE_LIMIT_IP_SOURCE=direct. Production must use vercel
# or trusted-proxy. An empty provider refuses form writes. It does not turn
# the limiter off.
RATE_LIMIT_PROVIDER=
RATE_LIMIT_IP_SOURCE=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_TOKEN=
ACCOUNTS_ENABLED=false
ADMIN_UI_ENABLED=false
STOREFRONT_ENABLED=false
CHECKOUT_ENABLED=false
PAYMENTS_ENABLED=false
