    "raised-on-green": { "ratio": 12.76, "wcag": "AAA" },
    "paper-on-green": { "ratio": 11.8, "wcag": "AAA" },
    "raktshali-on-paper": { "ratio": 8.99, "wcag": "AAA" },
    "raised-on-raktshali": { "ratio": 9.72, "wcag": "AAA" },
    "clay-on-paper": { "ratio": 5.84, "wcag": "AA" },
    "grain-on-paper": { "ratio": 2.04, "wcag": "fail" },
