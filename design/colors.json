{
  "name": "Ram Ganga Agro colour tokens",
  "status": "proposed for approval",
  "measured": "2026-11-12",
  "contrastMethod": "WCAG 2.x relative luminance",
  "color": {
    "paper": { "value": "#F4EFE6", "role": "page background" },
    "paper-raised": { "value": "#FBF8F3", "role": "cards, header, form surfaces" },
