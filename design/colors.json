    "focus": { "value": "#6E2A32", "role": "focus ring" },
    "danger": { "value": "#6E2A32", "role": "errors. Same hue as the rice accent. Pair with words, not colour alone." },
    "success": { "value": "#1C3328", "role": "confirmation. Pair with words." }
  },
  "pairs": {
