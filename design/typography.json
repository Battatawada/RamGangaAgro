{
  "name": "Ram Ganga Agro type tokens",
  "status": "implemented",
  "family": {
    "display": {
      "name": "Fraunces",
      "css": "\"Fraunces\", \"Iowan Old Style\", Palatino, Georgia, serif",
      "axes": ["opsz", "wght", "SOFT", "WONK"],
      "use": "Short English titles and the wordmark"
    },
    "sans": {
      "name": "Noto Sans",
      "css": "\"Noto Sans\", \"Segoe UI\", system-ui, sans-serif",
      "subsets": ["latin", "devanagari"],
      "use": "Body, UI, navigation, forms, product facts"
    },
    "devanagariDisplay": {
      "name": "Noto Serif Devanagari",
      "css": "\"Noto Serif Devanagari\", serif",
      "use": "Hindi headings on /hi"
    }
  },
  "loading": {
    "method": "next/font/google",
    "display": "swap",
    "note": "Do not load a third Latin family. Do not vendor NIS Tak."
  },
  "scale": {
    "display": { "min": "2.5rem", "max": "4.75rem", "lineHeight": 1.05, "weight": 560, "tracking": "-0.02em", "family": "display" },
    "h1": { "min": "2.25rem", "max": "3.5rem", "lineHeight": 1.1, "weight": 560, "tracking": "-0.02em", "family": "display" },
    "h2": { "min": "1.75rem", "max": "2.5rem", "lineHeight": 1.15, "weight": 520, "tracking": "-0.015em", "family": "display" },
    "h3": { "min": "1.35rem", "max": "1.75rem", "lineHeight": 1.25, "weight": 520, "family": "display" },
    "body-lg": { "size": "1.25rem", "lineHeight": 1.55, "weight": 400, "family": "sans" },
    "body": { "size": "1.0625rem", "lineHeight": 1.65, "weight": 400, "family": "sans", "measure": "40rem" },
    "eyebrow": { "size": "0.75rem", "lineHeight": 1.2, "weight": 500, "tracking": "0.16em", "transform": "uppercase", "family": "sans" },
    "button": { "size": "0.9375rem", "lineHeight": 1, "weight": 500, "tracking": "0.01em", "family": "sans", "minHeight": "48px", "radius": "2px" }
  },
  "responsive": "Display and headings use clamp(). Body sizes stay fixed."
}